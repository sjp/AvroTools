<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Compiles Avro IDL to protocols and schemas, checks two schemas for compatibility under Avro's schema-evolution rules, prints a semantic diff between schema versions, and encodes Avro data as JSON. A pure C# implementation that needs no Java runtime.</Description>
    <PackageReleaseNotes>Release notes are at https://github.com/sjp/AvroTools/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>avro;idl;apache-avro;schema;schema-evolution;compatibility;diff;json</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <PackageId>SJP.Avro.Tools</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" />
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SJP.Avro.Tools.Tests" />
  </ItemGroup>

</Project>
