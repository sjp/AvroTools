<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>avrotool</AssemblyName>
    <Nullable>enable</Nullable>

    <RollForward>Major</RollForward>

    <!-- Every culture is the invariant culture, which is the one the tool already parses and
         formats with. It also lets the tool start on an image that carries no ICU library,
         where it would otherwise fail before reaching Main. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The tool only ever surfaces English text, so the translated resources that come with
         the code generator's dependencies are left out of the package rather than shipped as
         several megabytes nothing reads. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Description>An Avro IDL compiler, C# code generator and schema toolkit as a .NET tool. Compiles Avro IDL to protocols and schemas, generates readable C# for them, checks two schemas for compatibility under Avro's schema-evolution rules, prints a semantic diff between schema versions, prints the Parsing Canonical Form and fingerprints of a schema, and inspects Avro object container files.</Description>
    <PackageReleaseNotes>Release notes are at https://github.com/sjp/AvroTools/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>avro;idl;apache-avro;code-generation;codegen;schema;schema-evolution;compatibility;diff;canonical-form;fingerprint;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>SJP.AvroTool</PackageId>
    <ToolCommandName>avrotool</ToolCommandName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Analyzer" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.11" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
    <PackageReference Include="Spectre.Console.Cli.Extensions.DependencyInjection" Version="0.28.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SJP.Avro.Tools.CodeGen\SJP.Avro.Tools.CodeGen.csproj" />
    <ProjectReference Include="..\SJP.Avro.Tools\SJP.Avro.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="$(AssemblyName).Tests" />
    <!-- The assembly the mocking library generates its proxies into, so that tests can mock
         the internal interfaces the commands depend on. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
