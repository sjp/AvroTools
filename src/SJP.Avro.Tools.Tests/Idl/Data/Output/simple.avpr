{
  "protocol": "Simple",
  "namespace": "org.apache.avro.test",
  "doc": "A simple test case.",
  "types": [
    {
      "type": "enum",
      "name": "Kind",
      "symbols": [
        "FOO",
        "BAR",
        "BAZ"
      ],
      "namespace": "org.apache.avro.test",
      "doc": "A kind of record.",
      "aliases": [
        "org.foo.KindOf"
      ]
    },
    {
      "type": "enum",
      "name": "Status",
      "symbols": [
        "A",
        "B",
        "C"
      ],
      "namespace": "org.apache.avro.test",
      "default": "C"
    },
    {
      "type": "record",
      "name": "TestRecord",
      "fields": [
        {
          "name": "name",
          "type": {
            "type": "string",
            "avro.java.string": "String"
          },
          "default": "foo",
          "order": "ignore"
        },
        {
          "name": "kind",
          "type": "Kind",
          "doc": "The kind of record.",
          "order": "descending"
        },
        {
          "name": "status",
          "type": "Status",
          "doc": "The status of the record.",
          "default": "A"
        },
        {
          "name": "hash",
          "type": {
            "type": "fixed",
            "name": "MD5",
            "size": 16,
            "namespace": "org.apache.avro.test",
            "doc": "An MD5 hash."
          },
          "default": "0000000000000000"
        },
        {
          "name": "nullableHash",
          "type": [
            "null",
            "MD5"
          ],
          "default": null,
          "aliases": [
            "oldhash",
            "hsh"
          ]
        },
        {
          "name": "value",
          "type": "double",
          "default": 1000.0
        },
        {
          "name": "average",
          "type": "float",
          "default": -8.0
        },
        {
          "name": "d",
          "type": {
            "type": "int",
            "logicalType": "date"
          },
          "default": 0
        },
        {
          "name": "t",
          "type": [
            {
              "type": "int",
              "logicalType": "time-millis"
            },
            "null"
          ],
          "default": 0
        },
        {
          "name": "l",
          "type": {
            "type": "long",
            "foo.bar": "bar.foo"
          },
          "default": 0
        },
        {
          "name": "a",
          "type": {
            "type": "array",
            "items": "string",
            "foo.bar.bar": "foo.bar2"
          },
          "default": []
        },
        {
          "name": "prop",
          "type": {
            "type": [
              "null",
              "string"
            ],
            "foo.foo.bar": 42,
            "foo.foo.foo": "3foo"
          },
          "default": null
        },
        {
          "name": "numbers",
          "type": {
            "type": "array",
            "items": "int"
          },
          "default": []
        },
        {
          "name": "dictionary",
          "type": {
            "type": "map",
            "values": "string"
          },
          "default": {}
        }
      ],
      "namespace": "org.apache.avro.test",
      "doc": "A TestRecord.",
      "my-property": {
        "key": 3
      }
    },
    {
      "type": "error",
      "name": "TestError",
      "fields": [
        {
          "name": "message",
          "type": "string"
        }
      ],
      "namespace": "org.apache.avro.test"
    }
  ],
  "messages": {
    "hello": {
      "request": [
        {
          "name": "greeting",
          "type": "string"
        }
      ],
      "response": "string",
      "doc": "method 'hello' takes @parameter 'greeting'"
    },
    "echo": {
      "request": [
        {
          "name": "record",
          "type": "TestRecord",
          "default": {
            "name": "bar",
            "kind": "BAR"
          }
        }
      ],
      "response": "TestRecord"
    },
    "add": {
      "request": [
        {
          "name": "arg1",
          "type": "int"
        },
        {
          "name": "arg2",
          "type": "int",
          "default": 0
        }
      ],
      "response": "int",
      "doc": "method 'add' takes @parameter 'arg1' @parameter 'arg2'",
      "specialProp": "test"
    },
    "echoBytes": {
      "request": [
        {
          "name": "data",
          "type": "bytes"
        }
      ],
      "response": "bytes"
    },
    "error": {
      "request": [],
      "response": "null",
      "errors": [
        "TestError"
      ]
    },
    "ping": {
      "request": [],
      "response": "null",
      "one-way": true
    }
  },
  "version": "1.0.5"
}
